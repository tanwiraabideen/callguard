# Optional. Copy to backend/.env to override the defaults in app/config.py.
# Never commit .env.

# Used for real transcription and to regenerate the call audio.
# With no key, calls use the mock transcript instead.
# ELEVENLABS_API_KEY=
# TRANSCRIPTION_MODE=auto

# Claude for the risk check and the agent. With no key, the risk engine uses
# rules alone and the agent follows a fixed plan.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# AGENT_MODEL=claude-haiku-5-5

# Agent tracing. With a key, each agent run gets a link on the page.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=callguard

# TRIGGER_PHRASES=let me grab a pen,let me find my glasses

# Set this when hosting. Empty means no passcode is asked for.
# DEMO_PASSCODE=
# MAX_CALL_SECONDS=180

# HOST=127.0.0.1
# PORT=8100
# RELOAD=true
# CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
